// iOS 네이티브 쪽이 읽는 소셜 로그인 값. Secrets.xcconfig로 복사해 채운다 (미커밋).
// config/local.json의 같은 이름 값과 맞춘다.
// xcconfig는 "//"를 주석으로 읽으므로 URL 값은 넣지 않는다.

// 카카오 네이티브 앱 키 (URL 스킴 kakao<키>에 쓰임)
KAKAO_NATIVE_APP_KEY =
// 구글 iOS 클라이언트 ID: 1234-abcd.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID =
// 위 값을 거꾸로 쓴 URL 스킴: com.googleusercontent.apps.1234-abcd
GOOGLE_REVERSED_CLIENT_ID =
